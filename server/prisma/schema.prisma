generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// =========================
// ENUMS
// =========================

enum UserRole {
  SUPER_ADMIN
  FRANCHISE_MANAGER
  CASHIER
  HR
  ACCOUNTANT
  CHEF
  WAITER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  HOLIDAY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  BILLING
  OUT_OF_SERVICE
}

enum OrderStatus {
  OPEN
  CONFIRMED
  PREPARING
  READY
  SERVED
  BILLED
  CANCELLED
}

enum KOTStatus {
  CREATED
  PRINTED
  ACCEPTED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PayrollStatus {
  DRAFT
  FINALIZED
  PAID
}

enum PrinterType {
  KOT
  RECEIPT
  BAR
  KITCHEN
  DESSERT
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdvanceStatus {
  PENDING
  APPROVED
  REJECTED
  DEDUCTED
}

enum InventoryTxType {
  PURCHASE
  CONSUMPTION
  WASTAGE
  ADJUSTMENT
  RETURN
  REVERSAL
  OPENING_STOCK
}

enum NotificationType {
  LOW_STOCK
  CRITICAL_STOCK
  EXPENSE_SUBMITTED
  PAYROLL_ADVANCE
  KOT_READY
  INFO
}

enum CustomerSegment {
  NEW
  REGULAR
  LOYAL
  VIP
  HIGH_VALUE
  AT_RISK
  INACTIVE
  WIN_BACK
  OCCASIONAL
}

enum CampaignType {
  WIN_BACK
  BIRTHDAY
  ANNIVERSARY
  LOYALTY_REWARD
  CUSTOM
  FESTIVE
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum CommunicationChannel {
  SMS
  WHATSAPP
  EMAIL
}

enum CommunicationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

// =========================
// FRANCHISE
// =========================

model Franchise {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  code     String  @unique
  address  String?
  phone    String?
  email    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  employees             Employee[]
  categories            Category[]
  menuItems             MenuItem[]
  tables                RestaurantTable[]
  orders                Order[]
  invoices              Invoice[]
  payments              Payment[]
  printers              Printer[]
  stations              PreparationStation[]
  payrolls              Payroll[]
  attendance            Attendance[]
  leaveRequests         LeaveRequest[]
  auditLogs             AuditLog[]
  inventoryItems        InventoryItem[]
  inventoryTransactions InventoryTransaction[]
  recipes               Recipe[]
  purchases             Purchase[]
  expenseCategories     ExpenseCategory[]
  expenses              Expense[]
  employeeAdvances      EmployeeAdvance[]
  notifications         Notification[]
  customers             Customer[]
  customerVisits        CustomerVisit[]
  campaigns             Campaign[]
}

// =========================
// USERS
// =========================

model User {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  franchiseId String?  @db.ObjectId

  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  franchise Franchise? @relation(fields: [franchiseId], references: [id])

  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([franchiseId])
}

// =========================
// EMPLOYEES
// =========================

model Employee {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  franchiseId String   @db.ObjectId

  employeeCode String
  firstName    String
  lastName     String?
  phone        String?
  email        String?
  designation  String?
  joiningDate  DateTime
  status       EmployeeStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  franchise Franchise @relation(fields: [franchiseId], references: [id])

  attendance      Attendance[]
  leaveRequests   LeaveRequest[]
  salaryStructure SalaryStructure?
  payrollItems    PayrollItem[]
  advances        EmployeeAdvance[]

  @@unique([franchiseId, employeeCode])
  @@index([franchiseId])
}

// =========================
// ATTENDANCE
// =========================

model Attendance {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  franchiseId String   @db.ObjectId
  employeeId  String   @db.ObjectId

  date   DateTime
  status AttendanceStatus

  checkIn  DateTime?
  checkOut DateTime?
  notes    String?

  createdAt DateTime @default(now())

  franchise Franchise @relation(fields: [franchiseId], references: [id])
  employee  Employee  @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([franchiseId, date])
}

// =========================
// LEAVE REQUESTS
// =========================

model LeaveRequest {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  franchiseId String      @db.ObjectId
  employeeId  String      @db.ObjectId

  startDate   DateTime
  endDate     DateTime
  reason      String?
  status      LeaveStatus @default(PENDING)
  approvedBy  String?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  franchise Franchise @relation(fields: [franchiseId], references: [id])
  employee  Employee  @relation(fields: [employeeId], references: [id])

  @@index([franchiseId])
  @@index([employeeId])
}

// =========================
// SALARY & PAYROLL
// =========================

model SalaryStructure {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  employeeId String @unique @db.ObjectId

  basicSalary  Float
  allowances   Float @default(0)
  overtimeRate Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
}

model Payroll {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  franchiseId String   @db.ObjectId

  month  Int
  year   Int
  status PayrollStatus @default(DRAFT)

  totalGross      Float @default(0)
  totalDeductions Float @default(0)
  totalNet        Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  franchise Franchise     @relation(fields: [franchiseId], references: [id])
  items     PayrollItem[]

  @@unique([franchiseId, month, year])
  @@index([franchiseId])
}

model PayrollItem {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  payrollId  String @db.ObjectId
  employeeId String @db.ObjectId

  basicSalary      Float
  allowances       Float @default(0)
  overtime         Float @default(0)
  bonus            Float @default(0)
  deductions       Float @default(0)
  advance          Float @default(0)
  advancesDeducted Float @default(0)
  netSalary        Float

  createdAt DateTime @default(now())

  payroll  Payroll  @relation(fields: [payrollId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([payrollId, employeeId])
}

model EmployeeAdvance {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  franchiseId String        @db.ObjectId
  employeeId  String        @db.ObjectId

  amount        Float
  reason        String?
  paymentMethod PaymentMethod @default(CASH)
  status        AdvanceStatus @default(APPROVED)
  advanceDate   DateTime      @default(now())
  approvedBy    String?
  notes         String?
  payrollId     String?       @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  franchise Franchise @relation(fields: [franchiseId], references: [id])
  employee  Employee  @relation(fields: [employeeId], references: [id])

  @@index([franchiseId])
  @@index([employeeId])
}

// =========================
// EXPENSES
// =========================

model ExpenseCategory {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  franchiseId String  @db.ObjectId
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  franchise Franchise @relation(fields: [franchiseId], references: [id])
  expenses  Expense[]

  @@unique([franchiseId, name])
  @@index([franchiseId])
}

model Expense {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  franchiseId String  @db.ObjectId
  categoryId  String  @db.ObjectId

  title         String
  description   String?
  amount        Float
  paymentMethod PaymentMethod @default(CASH)
  status        ExpenseStatus @default(PENDING)
  recordedBy    String?
  approvedBy    String?
  expenseDate   DateTime      @default(now())
  receiptUrl    String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  franchise Franchise       @relation(fields: [franchiseId], references: [id])
  category  ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([franchiseId])
  @@index([categoryId])
}

// =========================
// INVENTORY & SOP / RECIPES
// =========================

model InventoryItem {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  franchiseId String  @db.ObjectId

  name          String
  code          String?
  category      String?
  unit          String        // e.g. kg, g, l, ml, pcs
  currentStock  Float   @default(0)
  minimumStock  Float   @default(0)
  reorderLevel  Float   @default(0)
  purchasePrice Float   @default(0)
  supplier      String?
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  franchise    Franchise              @relation(fields: [franchiseId], references: [id])
  recipeItems  RecipeItem[]
  transactions InventoryTransaction[]
  purchaseItems PurchaseItem[]

  @@unique([franchiseId, name])
  @@unique([franchiseId, code])
  @@index([franchiseId])
}

model InventoryTransaction {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  franchiseId     String          @db.ObjectId
  inventoryItemId String          @db.ObjectId

  type          InventoryTxType
  quantity      Float
  previousStock Float
  newStock      Float
  unitPrice     Float?
  referenceType String?         // ORDER, KOT, PURCHASE, ADJUSTMENT, WASTAGE
  referenceId   String?
  notes         String?
  performedBy   String?

  createdAt DateTime @default(now())

  franchise     Franchise     @relation(fields: [franchiseId], references: [id])
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([franchiseId])
  @@index([inventoryItemId])
  @@index([createdAt])
}

model Recipe {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  franchiseId String  @db.ObjectId
  menuItemId  String  @unique @db.ObjectId

  name              String
  prepInstructions  String?
  servingSize       String?
  wastageAllowance  Float   @default(0) // percentage
  isActive          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  franchise Franchise    @relation(fields: [franchiseId], references: [id])
  menuItem  MenuItem     @relation(fields: [menuItemId], references: [id])
  items     RecipeItem[]

  @@index([franchiseId])
}

model RecipeItem {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  recipeId        String @db.ObjectId
  inventoryItemId String @db.ObjectId

  quantity         Float
  unit             String  // e.g. g, ml, pcs
  wastageAllowance Float   @default(0)

  recipe        Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@unique([recipeId, inventoryItemId])
  @@index([recipeId])
}

model Purchase {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  franchiseId String   @db.ObjectId

  invoiceNumber String
  supplier      String
  totalAmount   Float
  receivedDate  DateTime @default(now())
  receivedBy    String?
  notes         String?
  status        String   @default("COMPLETED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  franchise Franchise      @relation(fields: [franchiseId], references: [id])
  items     PurchaseItem[]

  @@index([franchiseId])
}

model PurchaseItem {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  purchaseId      String @db.ObjectId
  inventoryItemId String @db.ObjectId

  quantity   Float
  unitPrice  Float
  totalPrice Float

  purchase      Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([purchaseId])
}

// =========================
// MENU
// =========================

model Category {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  franchiseId String  @db.ObjectId

  name        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  franchise Franchise  @relation(fields: [franchiseId], references: [id])
  menuItems MenuItem[]

  @@unique([franchiseId, name])
  @@index([franchiseId])
}

model MenuItem {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  franchiseId String  @db.ObjectId
  categoryId  String  @db.ObjectId
  stationId   String? @db.ObjectId

  name        String
  code        String  @default("")
  description String?
  price       Float
  isAvailable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  franchise Franchise           @relation(fields: [franchiseId], references: [id])
  category  Category            @relation(fields: [categoryId], references: [id])
  station   PreparationStation? @relation(fields: [stationId], references: [id])

  orderItems OrderItem[]
  kotItems   KOTItem[]
  recipe     Recipe?

  @@unique([franchiseId, code])
  @@index([franchiseId])
  @@index([categoryId])
  @@index([stationId])
}

// =========================
// TABLES & SESSIONS
// =========================

model RestaurantTable {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  franchiseId String @db.ObjectId

  tableNumber      String
  capacity         Int
  currentOccupancy Int         @default(0)
  status           TableStatus @default(AVAILABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  franchise Franchise      @relation(fields: [franchiseId], references: [id])
  sessions  TableSession[]

  @@unique([franchiseId, tableNumber])
  @@index([franchiseId])
}

model TableSession {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  tableId     String    @db.ObjectId
  partyName   String?
  guestCount  Int       @default(1)
  status      String    @default("ACTIVE")
  startedAt   DateTime  @default(now())
  endedAt     DateTime?

  table  RestaurantTable @relation(fields: [tableId], references: [id])
  orders Order[]

  @@index([tableId])
}

// =========================
// ORDERS
// =========================

model Order {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  franchiseId    String  @db.ObjectId
  tableSessionId String? @db.ObjectId
  customerId     String? @db.ObjectId

  orderNumber String
  status      OrderStatus @default(OPEN)

  partyName          String?
  guestCount         Int       @default(1)
  kotDecision        String?   @default("PENDING") // PENDING, SENT, SKIPPED
  paymentConfirmedAt DateTime?
  kotSentAt          DateTime?

  subtotal Float @default(0)
  discount Float @default(0)
  tax      Float @default(0)
  total    Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  franchise    Franchise     @relation(fields: [franchiseId], references: [id])
  tableSession TableSession? @relation(fields: [tableSessionId], references: [id])
  customer     Customer?     @relation(fields: [customerId], references: [id])

  items   OrderItem[]
  kots    KOT[]
  invoice Invoice?

  @@unique([franchiseId, orderNumber])
  @@index([franchiseId])
  @@index([tableSessionId])
  @@index([customerId])
}

model OrderItem {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  orderId    String @db.ObjectId
  menuItemId String @db.ObjectId

  quantity          Int
  unitPrice         Float
  totalPrice        Float
  notes             String?
  inventoryDeducted Boolean @default(false)

  order    Order    @relation(fields: [orderId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  kotItems KOTItem[]

  @@index([orderId])
}

// =========================
// KOT
// =========================

model KOT {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  franchiseId String  @db.ObjectId
  orderId     String  @db.ObjectId
  stationId   String? @db.ObjectId

  kotNumber String
  status    KOTStatus @default(CREATED)

  createdAt   DateTime  @default(now())
  printedAt   DateTime?
  completedAt DateTime?

  order   Order               @relation(fields: [orderId], references: [id])
  station PreparationStation? @relation(fields: [stationId], references: [id])
  items   KOTItem[]

  @@unique([franchiseId, kotNumber])
  @@index([orderId])
  @@index([stationId])
}

model KOTItem {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  kotId       String @db.ObjectId
  orderItemId String @db.ObjectId
  menuItemId  String @db.ObjectId

  quantity Int
  notes    String?

  kot       KOT       @relation(fields: [kotId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  menuItem  MenuItem  @relation(fields: [menuItemId], references: [id])

  @@index([kotId])
}

// =========================
// BILLING & PAYMENTS
// =========================

model Invoice {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  franchiseId String @db.ObjectId
  orderId     String @unique @db.ObjectId

  invoiceNumber String @unique

  subtotal Float
  discount Float @default(0)
  tax      Float @default(0)
  total    Float

  createdAt DateTime @default(now())

  franchise Franchise @relation(fields: [franchiseId], references: [id])
  order     Order     @relation(fields: [orderId], references: [id])
  payments  Payment[]

  @@index([franchiseId])
}

model Payment {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  franchiseId String @db.ObjectId
  invoiceId   String @db.ObjectId

  amount Float
  method PaymentMethod
  status PaymentStatus @default(PENDING)

  transactionId String?
  paidAt        DateTime?

  createdAt DateTime @default(now())

  franchise Franchise @relation(fields: [franchiseId], references: [id])
  invoice   Invoice   @relation(fields: [invoiceId], references: [id])

  @@index([franchiseId])
  @@index([invoiceId])
}

// =========================
// KITCHEN / PRINTING
// =========================

model PreparationStation {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  franchiseId String  @db.ObjectId

  name     String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  franchise Franchise  @relation(fields: [franchiseId], references: [id])
  kots      KOT[]
  printers  Printer[]
  menuItems MenuItem[]

  @@unique([franchiseId, name])
}

model Printer {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  franchiseId String   @db.ObjectId
  stationId   String?  @db.ObjectId

  name      String
  type      PrinterType
  ipAddress String?
  port      Int?
  isActive  Boolean     @default(true)

  createdAt DateTime @default(now())

  franchise Franchise           @relation(fields: [franchiseId], references: [id])
  station   PreparationStation? @relation(fields: [stationId], references: [id])

  @@index([franchiseId])
}

// =========================
// NOTIFICATIONS
// =========================

model Notification {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  franchiseId String           @db.ObjectId
  userId      String?          @db.ObjectId

  type      NotificationType @default(INFO)
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?

  createdAt DateTime @default(now())

  franchise Franchise @relation(fields: [franchiseId], references: [id])
  user      User?     @relation(fields: [userId], references: [id])

  @@index([franchiseId])
  @@index([userId])
  @@index([isRead])
}

// =========================
// AUDIT LOG
// =========================

model AuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  franchiseId String?  @db.ObjectId
  userId      String?  @db.ObjectId

  action   String
  entity   String
  entityId String?
  oldData  Json?
  newData  Json?

  createdAt DateTime @default(now())

  franchise Franchise? @relation(fields: [franchiseId], references: [id])
  user      User?      @relation(fields: [userId], references: [id])

  @@index([franchiseId])
  @@index([userId])
  @@index([createdAt])
}

// =========================
// CUSTOMER & CRM
// =========================

model Customer {
  id                String            @id @default(auto()) @map("_id") @db.ObjectId
  franchiseId       String?           @db.ObjectId
  name              String
  phone             String            @unique
  email             String?
  birthday          DateTime?
  anniversary       DateTime?
  marketingConsent  Boolean           @default(true)
  optOutAt          DateTime?
  segment           CustomerSegment   @default(NEW)
  totalVisits       Int               @default(0)
  totalSpend        Float             @default(0)
  averageOrderValue Float             @default(0)
  lastVisitAt       DateTime?
  firstVisitAt      DateTime?
  notes             String?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  franchise         Franchise?        @relation(fields: [franchiseId], references: [id])
  visits            CustomerVisit[]
  orders            Order[]
  communicationLogs CommunicationLog[]
  preference        CustomerPreference?

  @@index([franchiseId])
  @@index([segment])
  @@index([lastVisitAt])
}

model CustomerVisit {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId     String   @db.ObjectId
  franchiseId    String   @db.ObjectId
  orderId        String?  @unique @db.ObjectId
  tableSessionId String?  @db.ObjectId
  spend          Float    @default(0)
  itemsCount     Int      @default(0)
  visitDate      DateTime @default(now())

  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  franchise Franchise @relation(fields: [franchiseId], references: [id])

  @@index([customerId])
  @@index([franchiseId])
  @@index([visitDate])
}

model CustomerPreference {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId         String   @unique @db.ObjectId
  favoriteCategoryId String?  @db.ObjectId
  favoriteMenuItemId String?  @db.ObjectId
  favoriteItemName   String?
  dietaryNotes       String?
  spicePreference    String?
  seatingPreference  String?
  updatedAt          DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Campaign {
  id              String               @id @default(auto()) @map("_id") @db.ObjectId
  franchiseId     String?              @db.ObjectId
  name            String
  type            CampaignType
  status          CampaignStatus       @default(DRAFT)
  channel         CommunicationChannel @default(SMS)
  targetSegment   CustomerSegment?
  messageTemplate String
  discountCode    String?
  discountPercent Float?
  scheduledAt     DateTime?
  sentAt          DateTime?
  cooldownDays    Int                  @default(7)
  totalRecipients Int                  @default(0)
  deliveredCount  Int                  @default(0)
  failedCount     Int                  @default(0)

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  franchise         Franchise?         @relation(fields: [franchiseId], references: [id])
  rules             CampaignRule[]
  communicationLogs CommunicationLog[]

  @@index([franchiseId])
  @@index([status])
}

model CampaignRule {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  campaignId String   @db.ObjectId
  ruleType   String
  condition  String
  value      String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model CommunicationLog {
  id            String               @id @default(auto()) @map("_id") @db.ObjectId
  customerId    String               @db.ObjectId
  campaignId    String?              @db.ObjectId
  channel       CommunicationChannel
  recipient     String
  message       String
  status        CommunicationStatus  @default(QUEUED)
  failureReason String?
  sentAt        DateTime?

  createdAt     DateTime             @default(now())

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([campaignId])
  @@index([status])
  @@index([createdAt])
}

// =========================
// BRAND SETTINGS & BUSINESS PROFILE
// =========================

model BrandSettings {
  id                     String   @id @default(auto()) @map("_id") @db.ObjectId
  businessName           String   @default("My Restaurant Brand")
  tagline                String?
  logoUrl                String?
  email                  String?
  phone                  String?
  address                String?
  taxNumber              String?  // GSTIN / Tax ID
  fssaiNumber            String?  // FSSAI Food License
  currencySymbol         String   @default("₹")
  currencyCode           String   @default("INR")
  defaultGstRate         Float    @default(5.0)
  vipDiscountPercent     Float    @default(20.0)
  loyalDiscountPercent   Float    @default(15.0)
  regularDiscountPercent Float    @default(10.0)
  whatsappSupportNumber  String?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}
