generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================
// ENUMS
// =========================

enum UserRole {
  SUPER_ADMIN
  FRANCHISE_MANAGER
  CASHIER
  HR
  ACCOUNTANT
  CHEF
  WAITER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  HOLIDAY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  BILLING
  OUT_OF_SERVICE
}

enum OrderStatus {
  OPEN
  CONFIRMED
  PREPARING
  READY
  SERVED
  BILLED
  CANCELLED
}

enum KOTStatus {
  CREATED
  PRINTED
  ACCEPTED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PayrollStatus {
  DRAFT
  FINALIZED
  PAID
}

enum PrinterType {
  KOT
  RECEIPT
  BAR
  KITCHEN
  DESSERT
  OTHER
}

// =========================
// FRANCHISE
// =========================

model Franchise {
  id       String  @id @default(uuid())
  name     String
  code     String  @unique
  address  String?
  phone    String?
  email    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  employees  Employee[]
  categories Category[]
  menuItems  MenuItem[]
  tables     RestaurantTable[]
  orders     Order[]
  invoices   Invoice[]
  payments   Payment[]
  printers   Printer[]
  stations   PreparationStation[]
  payrolls   Payroll[]
  attendance Attendance[]
  leaveRequests LeaveRequest[]
  auditLogs  AuditLog[]
}

// =========================
// USERS
// =========================

model User {
  id          String  @id @default(uuid())
  franchiseId String?

  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  franchise Franchise? @relation(fields: [franchiseId], references: [id])

  auditLogs AuditLog[]

  @@index([franchiseId])
}

// =========================
// EMPLOYEES
// =========================

model Employee {
  id          String @id @default(uuid())
  franchiseId String

  employeeCode String
  firstName    String
  lastName     String?
  phone        String?
  email        String?
  designation  String?
  joiningDate  DateTime
  status       EmployeeStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  franchise Franchise @relation(fields: [franchiseId], references: [id])

  attendance      Attendance[]
  leaveRequests   LeaveRequest[]
  salaryStructure SalaryStructure?
  payrollItems    PayrollItem[]

  @@unique([franchiseId, employeeCode])
  @@index([franchiseId])
}

// =========================
// ATTENDANCE
// =========================

model Attendance {
  id          String @id @default(uuid())
  franchiseId String
  employeeId  String

  date   DateTime
  status AttendanceStatus

  checkIn  DateTime?
  checkOut DateTime?
  notes    String?

  createdAt DateTime @default(now())

  franchise Franchise @relation(fields: [franchiseId], references: [id])
  employee  Employee  @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([franchiseId, date])
}

// =========================
// LEAVE REQUESTS
// =========================

model LeaveRequest {
  id          String      @id @default(uuid())
  franchiseId String
  employeeId  String

  startDate   DateTime
  endDate     DateTime
  reason      String?
  status      LeaveStatus @default(PENDING)
  approvedBy  String?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  franchise Franchise @relation(fields: [franchiseId], references: [id])
  employee  Employee  @relation(fields: [employeeId], references: [id])

  @@index([franchiseId])
  @@index([employeeId])
}

// =========================
// SALARY
// =========================

model SalaryStructure {
  id         String @id @default(uuid())
  employeeId String @unique

  basicSalary  Decimal @db.Decimal(12, 2)
  allowances   Decimal @default(0) @db.Decimal(12, 2)
  overtimeRate Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
}

// =========================
// PAYROLL
// =========================

model Payroll {
  id          String @id @default(uuid())
  franchiseId String

  month  Int
  year   Int
  status PayrollStatus @default(DRAFT)

  totalGross      Decimal @default(0) @db.Decimal(14, 2)
  totalDeductions Decimal @default(0) @db.Decimal(14, 2)
  totalNet        Decimal @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  franchise Franchise     @relation(fields: [franchiseId], references: [id])
  items     PayrollItem[]

  @@unique([franchiseId, month, year])
  @@index([franchiseId])
}

model PayrollItem {
  id         String @id @default(uuid())
  payrollId  String
  employeeId String

  basicSalary Decimal @db.Decimal(12, 2)
  allowances  Decimal @default(0) @db.Decimal(12, 2)
  overtime    Decimal @default(0) @db.Decimal(12, 2)
  bonus       Decimal @default(0) @db.Decimal(12, 2)
  deductions  Decimal @default(0) @db.Decimal(12, 2)
  advance     Decimal @default(0) @db.Decimal(12, 2)
  netSalary   Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  payroll  Payroll  @relation(fields: [payrollId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([payrollId, employeeId])
}

// =========================
// MENU
// =========================

model Category {
  id          String @id @default(uuid())
  franchiseId String

  name        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  franchise Franchise  @relation(fields: [franchiseId], references: [id])
  menuItems MenuItem[]

  @@unique([franchiseId, name])
  @@index([franchiseId])
}

model MenuItem {
  id          String  @id @default(uuid())
  franchiseId String
  categoryId  String
  stationId   String?

  name        String
  description String?
  price       Decimal @db.Decimal(10, 2)
  isAvailable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  franchise Franchise           @relation(fields: [franchiseId], references: [id])
  category  Category            @relation(fields: [categoryId], references: [id])
  station   PreparationStation? @relation(fields: [stationId], references: [id])

  orderItems OrderItem[]
  kotItems   KOTItem[]

  @@index([franchiseId])
  @@index([categoryId])
  @@index([stationId])
}

// =========================
// TABLES
// =========================

model RestaurantTable {
  id          String @id @default(uuid())
  franchiseId String

  tableNumber String
  capacity    Int
  status      TableStatus @default(AVAILABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  franchise Franchise      @relation(fields: [franchiseId], references: [id])
  sessions  TableSession[]

  @@unique([franchiseId, tableNumber])
  @@index([franchiseId])
}

model TableSession {
  id      String @id @default(uuid())
  tableId String

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  table  RestaurantTable @relation(fields: [tableId], references: [id])
  orders Order[]

  @@index([tableId])
}

// =========================
// ORDERS
// =========================

model Order {
  id             String  @id @default(uuid())
  franchiseId    String
  tableSessionId String?

  orderNumber String
  status      OrderStatus @default(OPEN)

  subtotal Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  franchise    Franchise     @relation(fields: [franchiseId], references: [id])
  tableSession TableSession? @relation(fields: [tableSessionId], references: [id])

  items   OrderItem[]
  kots    KOT[]
  invoice Invoice?

  @@unique([franchiseId, orderNumber])
  @@index([franchiseId])
  @@index([tableSessionId])
}

model OrderItem {
  id         String @id @default(uuid())
  orderId    String
  menuItemId String

  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(12, 2)

  notes String?

  order    Order    @relation(fields: [orderId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  kotItems KOTItem[]

  @@index([orderId])
}

// =========================
// KOT
// =========================

model KOT {
  id          String  @id @default(uuid())
  franchiseId String
  orderId     String
  stationId   String?

  kotNumber String
  status    KOTStatus @default(CREATED)

  createdAt   DateTime  @default(now())
  printedAt   DateTime?
  completedAt DateTime?

  order   Order               @relation(fields: [orderId], references: [id])
  station PreparationStation? @relation(fields: [stationId], references: [id])
  items   KOTItem[]

  @@unique([franchiseId, kotNumber])
  @@index([orderId])
  @@index([stationId])
}

model KOTItem {
  id          String @id @default(uuid())
  kotId       String
  orderItemId String
  menuItemId  String

  quantity Int
  notes    String?

  kot       KOT       @relation(fields: [kotId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  menuItem  MenuItem  @relation(fields: [menuItemId], references: [id])

  @@index([kotId])
}

// =========================
// BILLING
// =========================

model Invoice {
  id          String @id @default(uuid())
  franchiseId String
  orderId     String @unique

  invoiceNumber String @unique

  subtotal Decimal @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  franchise Franchise @relation(fields: [franchiseId], references: [id])
  order     Order     @relation(fields: [orderId], references: [id])
  payments  Payment[]

  @@index([franchiseId])
}

model Payment {
  id          String @id @default(uuid())
  franchiseId String
  invoiceId   String

  amount Decimal       @db.Decimal(12, 2)
  method PaymentMethod
  status PaymentStatus @default(PENDING)

  transactionId String?
  paidAt        DateTime?

  createdAt DateTime @default(now())

  franchise Franchise @relation(fields: [franchiseId], references: [id])
  invoice   Invoice   @relation(fields: [invoiceId], references: [id])

  @@index([franchiseId])
  @@index([invoiceId])
}

// =========================
// KITCHEN / PRINTING
// =========================

model PreparationStation {
  id          String @id @default(uuid())
  franchiseId String

  name     String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  franchise Franchise  @relation(fields: [franchiseId], references: [id])
  kots      KOT[]
  printers  Printer[]
  menuItems MenuItem[]

  @@unique([franchiseId, name])
}

model Printer {
  id          String  @id @default(uuid())
  franchiseId String
  stationId   String?

  name      String
  type      PrinterType
  ipAddress String?
  port      Int?
  isActive  Boolean     @default(true)

  createdAt DateTime @default(now())

  franchise Franchise           @relation(fields: [franchiseId], references: [id])
  station   PreparationStation? @relation(fields: [stationId], references: [id])

  @@index([franchiseId])
}

// =========================
// AUDIT LOG
// =========================

model AuditLog {
  id          String  @id @default(uuid())
  franchiseId String?
  userId      String?

  action   String
  entity   String
  entityId String?
  oldData  Json?
  newData  Json?

  createdAt DateTime @default(now())

  franchise Franchise? @relation(fields: [franchiseId], references: [id])
  user      User?      @relation(fields: [userId], references: [id])

  @@index([franchiseId])
  @@index([userId])
  @@index([createdAt])
}
